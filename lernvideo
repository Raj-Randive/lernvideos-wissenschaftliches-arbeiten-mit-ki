#!/usr/bin/env bash
# Starter: ./lernvideo <status|extract|audio|build> [video] [options]
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$DIR/tools/.venv"
if [ ! -x "$VENV/bin/python" ]; then
  echo "Erster Start: Python-Umgebung wird eingerichtet ..."
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q -r "$DIR/tools/requirements.txt"
fi
exec "$VENV/bin/python" -I "$DIR/tools/lernvideo.py" "$@"
